[sub_resource type="Shader" id="Shader_bonus"]
code = "shader_type canvas_item;\n\nvoid fragment() {\n\tvec2 uv = UV;\n\tfloat wave = sin((uv.x * 7.0 + uv.y * 3.0) + TIME * 1.8);\n\tvec3 color = 0.55 + 0.45 * cos(TIME * 1.2 + uv.xyx * vec3(5.0, 7.0, 9.0) + vec3(0.0, 2.1, 4.2));\n\tfloat edge = smoothstep(0.0, 0.16, uv.y) * smoothstep(1.0, 0.84, uv.y);\n\tCOLOR = vec4(color, (0.2 + 0.1 * wave) * edge);\n}\n"

[sub_resource type="ShaderMaterial" id="Material_bonus"]
shader = SubResource("Shader_bonus")

