[gd_resource type="Resource" script_class="TutorialStep" load_steps=5 format=3]

[ext_resource type="Script" path="res://features/tutorial/tutorial_step.gd" id="1"]
[ext_resource type="Script" path="res://features/tutorial/tutorial_transition.gd" id="2"]
[ext_resource type="Script" path="res://features/tutorial/tutorial_condition.gd" id="3"]

[sub_resource type="Resource" id="condition_human"]
script = ExtResource("3")
property_path = "player_index"
compare_value = "0"

[sub_resource type="Resource" id="condition_five"]
script = ExtResource("3")
property_path = "dice_value"
compare_value = "5"

[sub_resource type="Resource" id="to_rolled_five"]
script = ExtResource("2")
target_step_id = &"rolled_five"
trigger_mode = 1
event_key = &"action_roll"
conditions = Array[ExtResource("3")]([SubResource("condition_human"), SubResource("condition_five")])

[resource]
script = ExtResource("1")
step_id = &"wait_first_roll"
continue_mode = 1
blocks_gameplay = false
dim_background = false
input_locks = 130
transitions = Array[ExtResource("2")]([SubResource("to_rolled_five")])
editor_graph_position = Vector2(-180, 120)
