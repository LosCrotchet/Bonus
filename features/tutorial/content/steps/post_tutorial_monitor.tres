[sub_resource type="Resource" id="condition_human"]
script = ExtResource("3")
property_path = "player_index"
compare_value = "0"

[sub_resource type="Resource" id="condition_not_explained"]
script = ExtResource("3")
source = 1
property_path = "tutorial_bonus_explained"
operator = 7

[sub_resource type="Resource" id="to_human"]
script = ExtResource("2")
target_step_id = &"bonus_human_late"
