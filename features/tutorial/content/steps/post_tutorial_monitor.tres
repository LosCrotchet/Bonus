[gd_resource type="Resource" script_class="TutorialStep" load_steps=9 format=3]

[ext_resource type="Script" path="res://features/tutorial/tutorial_step.gd" id="1"]
[ext_resource type="Script" path="res://features/tutorial/tutorial_transition.gd" id="2"]
[ext_resource type="Script" path="res://features/tutorial/tutorial_condition.gd" id="3"]

[sub_resource type="Resource" id="condition_human"]
script = ExtResource("3")
property_path = "player_index"
compare_value = "0"

[sub_resource type="Resource" id="condition_other"]
script = ExtResource("3")
property_path = "player_index"
operator = 1
compare_value = "0"

[sub_resource type="Resource" id="condition_not_explained"]
script = ExtResource("3")
source = 1
property_path = "tutorial_bonus_explained"
operator = 7

[sub_resource type="Resource" id="to_human"]
script = ExtResource("2")
target_step_id = &"bonus_human_late"
trigger_mode = 1
event_key = &"bonus_started"
conditions = Array[ExtResource("3")]([SubResource("condition_human"), SubResource("condition_not_explained")])

[sub_resource type="Resource" id="to_other"]
script = ExtResource("2")
target_step_id = &"bonus_other_late"
trigger_mode = 1
event_key = &"bonus_started"
conditions = Array[ExtResource("3")]([SubResource("condition_other"), SubResource("condition_not_explained")])

[resource]
script = ExtResource("1")
step_id = &"post_tutorial_monitor"
continue_mode = 1
blocks_gameplay = false
dim_background = false
transitions = Array[ExtResource("2")]([SubResource("to_human"), SubResource("to_other")])
editor_graph_position = Vector2(2000, 120)
